{
  "name": "insane-game",
  "private": true,
  "version": "2.0.0",
  "description": "Insane Game (SameGame for the TI-83), rebuilt as an installable, offline-ready web app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "python3 scripts/make_icons.py"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-window": "^7.4.1"
  }
}
